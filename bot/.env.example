NODE_ENV=development

# @BotFather → /newbot bergan token
BOT_TOKEN=123456789:AAH...

# Backend API (docker-compose ichida: http://api:4000/api/v1)
API_URL=http://localhost:4000/api/v1

# Backend .env dagi BOT_API_SECRET bilan AYNAN bir xil (openssl rand -hex 32)
BOT_API_SECRET=change-me-bot-secret-at-least-32-characters

# Sayt manzili — "Saytga o'tish" tugmasi (faqat https domen bo'lsa ko'rsatiladi)
WEB_URL=http://localhost:5173

# Muhim hodisalarni (yangi band qilish, tasdiq, ...) Telegram'ga yuborish
TELEGRAM_NOTIFY=true
NOTIFY_INTERVAL_MS=5000

# Safar so'rovlari tashlanadigan Telegram guruh (botni guruhga qo'shing va guruhda /chatid yozing)
GROUP_CHAT_ID=
GROUP_POLL_MS=15000
