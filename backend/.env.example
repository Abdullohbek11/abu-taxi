NODE_ENV=development
PORT=4000

# ── MySQL 8 ── (yagona ma'lumotlar bazasi)
DATABASE_URL=mysql://abutax:abutax@localhost:3306/abutax
# docker-compose uchun (production'da albatta o'zgartiring)
MYSQL_DATABASE=abutax
MYSQL_USER=abutax
MYSQL_PASSWORD=abutax
MYSQL_ROOT_PASSWORD=abutax-root

# ── JWT ── (har biri alohida: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# ── HTTP ──
# CORS: ruxsat etilgan manbalar, bir nechta bo'lsa vergul bilan (production'da faqat https)
FRONTEND_URL=http://localhost:5173
# Nechta proxy ortida (nginx → 1). API to'g'ridan-to'g'ri ochiq bo'lsa 0 — aks holda IP limitlarini aylanib o'tish mumkin
TRUST_PROXY=1
# Refresh cookie: frontend va API turli saytlarda bo'lsa "none" (faqat HTTPS)
COOKIE_SAMESITE=lax
# Masalan: .abutax.uz (bo'sh — faqat API domeni)
COOKIE_DOMAIN=
# IP bo'yicha umumiy limit, daqiqasiga
RATE_LIMIT_PER_MIN=300
# Swagger /docs
DOCS_ENABLED=true

# ── Telegram bot (kirish kodlari va bildirishnomalar — bot/ papkasi) ──
# bot/.env dagi BOT_API_SECRET bilan AYNAN bir xil bo'lishi kerak (openssl rand -hex 32)
BOT_API_SECRET=change-me-bot-secret-at-least-32-characters
# Bot username'i (@ siz) — saytda "@AbuTaxBot ga kiring" ko'rsatish uchun
BOT_USERNAME=AbuTaxBot

# Safar so'rovi: haydovchilar shuncha daqiqada olmasa — Telegram guruhga (bot/.env dagi GROUP_CHAT_ID)
RIDE_REQUEST_GROUP_DELAY_MIN=10

# ── Fon vazifalari (node-cron) ──
CRON_ENABLED=true

# ── S3 (lokal: MinIO) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PUBLIC=abutax-public
S3_BUCKET_PRIVATE=abutax-private
# Public rasmlar uchun tashqi URL (CDN yoki MinIO)
S3_PUBLIC_URL=http://localhost:9000/abutax-public
# docker-compose MinIO hisobi (production'da o'zgartiring)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
